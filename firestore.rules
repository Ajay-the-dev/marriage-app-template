rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // weddings/{weddingId}: an account can own many.
    // Weddings saved before multi-wedding support use the owner's uid as id.
    match /weddings/{weddingId} {
      // Guests can open a single invitation by id, unless its owner has hidden it
      // (resource is null for an id that doesn't exist yet: creating one reads it first)
      allow get: if resource == null
        || !resource.data.get('hidden', false)
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
      // Owners can list their own (the query must filter on ownerId)
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;

      allow create: if request.auth != null
        && validWedding(weddingId, request.auth.uid)
        && validAgreement(request.resource.data.get('agreement', null))
        && withinLimits(request.resource.data.config, planLimits(request.auth.uid))
        && request.resource.data.get('uploads', 0) == 0;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validWedding(weddingId, request.auth.uid)
        // The signed agreement is a record; it can never change
        && request.resource.data.get('agreement', null) == resource.data.get('agreement', null)
        // The code can never change once set
        && (resource.data.get('code', null) == null
            || resource.data.code == request.resource.data.code)
        && validUpdate(planLimits(request.auth.uid));

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      function ownsWedding() {
        return request.auth != null
          && get(/databases/$(database)/documents/weddings/$(weddingId)).data.ownerId == request.auth.uid;
      }

      // versions/{versionId}: Plus keeps the config as it was before each save.
      // Owners can read and trim them; nobody can change one.
      match /versions/{versionId} {
        allow read, delete: if ownsWedding();
        allow create: if ownsWedding()
          && isPlus(request.auth.uid)
          && request.resource.data.keys().hasOnly(['config', 'savedAt'])
          && request.resource.data.config is map
          && request.resource.data.savedAt is timestamp;
      }

      // cards/{cardId}: printed invitation cards, kept as HTML. Only the owner
      // can see them, and not while the invitation is locked by the plan.
      match /cards/{cardId} {
        function canEdit() {
          return ownsWedding()
            && !get(/databases/$(database)/documents/weddings/$(weddingId)).data.get('locked', false);
        }
        function validCard() {
          let card = request.resource.data;
          return card.keys().hasOnly(['name', 'html', 'version', 'versions', 'paper', 'border', 'motif', 'theme', 'createdAt', 'updatedAt'])
            && card.name is string && card.name.size() <= 60
            && card.html is string && card.html.size() <= 100000
            // The wording version shown, and the edited text of each version (one per version at most)
            && card.get('version', '') is string && card.get('version', '').size() <= 30
            && card.get('versions', {}) is map && card.get('versions', {}).size() <= 20
            && card.paper is string && card.paper.size() <= 20
            && card.border is string && card.border.size() <= 20
            && card.motif is string && card.motif.size() <= 20
            && card.theme is string && card.theme.size() <= 40
            && card.updatedAt == request.time;
        }
        allow read, delete: if ownsWedding();
        allow create: if canEdit() && validCard() && request.resource.data.createdAt == request.time;
        allow update: if canEdit() && validCard() && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    function isPlus(uid) {
      let planDoc = /databases/$(database)/documents/plans/$(uid);
      return exists(planDoc) && get(planDoc).data.get('plan', '') == 'plus';
    }

    function validWedding(weddingId, uid) {
      let data = request.resource.data;
      let reserved = getAfter(/databases/$(database)/documents/codes/$(data.code)).data;
      return data.keys().hasOnly(['ownerId', 'code', 'config', 'createdAt', 'updatedAt', 'uploads', 'locked', 'editLocked', 'hidden', 'agreement'])
        && data.ownerId == uid
        && data.config is map
        // The code must be reserved for this user and this wedding
        // (older codes have no weddingId; their wedding's id is the uid)
        && reserved.uid == uid
        && reserved.get('weddingId', uid) == weddingId;
    }

    // Every new invitation needs the current agreement, signed now.
    // Keep the version in sync with src/config/agreement.js
    function validAgreement(agreement) {
      return agreement is map
        && agreement.keys().hasOnly(['version', 'name', 'signedAt'])
        && agreement.version == '2026-10-15.2'
        && agreement.name is string
        && agreement.name.trim().size() >= 2
        && agreement.name.size() <= 100
        && agreement.signedAt == request.time;
    }

    function validUpdate(limits) {
      let before = resource.data;
      let after = request.resource.data;
      let configChanged = after.config != before.config;
      let uploadsBefore = before.get('uploads', 0);
      let uploadsAfter = after.get('uploads', 0);
      let frozen = before.get('locked', false) || before.get('editLocked', false);
      // Content changes must fit the plan, and not while locked (by the plan or by the owner)
      return (!configChanged || (withinLimits(after.config, limits) && !frozen))
        // No new uploads while locked either
        && (!frozen || uploadsAfter == uploadsBefore)
        && after.get('editLocked', false) is bool
        && after.get('hidden', false) is bool
        // The upload counter only goes up, and only up to the plan's limit
        && uploadsAfter >= uploadsBefore
        && (uploadsAfter == uploadsBefore || uploadsAfter <= limits.uploads);
    }

    // Keep in sync with src/config/plans.js
    function planLimits(uid) {
      return isPlus(uid)
        ? { 'uploads': 100, 'events': 10, 'milestones': 25, 'gallery': 25, 'saveTheDate': 5 }
        : { 'uploads': 25, 'events': 3, 'milestones': 10, 'gallery': 4, 'saveTheDate': 2 };
    }

    function withinLimits(config, limits) {
      return config.eventsPage.events.size() <= limits.events
        && config.storyPage.milestones.size() <= limits.milestones
        && config.momentsPage.images.size() <= limits.gallery
        && config.saveTheDate.images.size() <= limits.saveTheDate
        && withinTextLimits(config);
    }

    // Longest text for fixed fields. Keep in sync with MAX_LENGTH in src/utils/validation.js
    // (list items can't be checked here: rules have no loops)
    function withinTextLimits(config) {
      let groom = config.get('groom', {});
      let bride = config.get('bride', {});
      let site = config.get('site', {});
      return groom.get('name', '').size() <= 60
        && groom.get('shortName', '').size() <= 30
        && groom.get('bio', '').size() <= 600
        && bride.get('name', '').size() <= 60
        && bride.get('shortName', '').size() <= 30
        && bride.get('bio', '').size() <= 600
        && config.get('hero', {}).get('inviteLine', '').size() <= 120
        && site.get('title', '').size() <= 100
        && site.get('monogram', '').size() <= 6
        && site.get('shareMessage', '').size() <= 500;
    }

    // plans/{uid}: { plan: 'plus' }. Set by hand in the console; missing = Free.
    // Public so guest links can apply the owner's plan.
    match /plans/{uid} {
      allow get: if true;
    }

    // views/{weddingId}: unique guest visitors. Guests aren't signed in, so
    // anyone may add exactly 1. Public so guest links can apply the visitor limit.
    match /views/{weddingId} {
      allow get: if true;
      allow create: if exists(/databases/$(database)/documents/weddings/$(weddingId))
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // codes/{code}: reserves each 12-character code for exactly one wedding
    match /codes/{code} {
      allow get: if true;
      allow create: if signedInAs(request.resource.data.uid)
        && code.matches('^[A-Z0-9]{12}$')
        && request.resource.data.keys().hasOnly(['uid', 'weddingId', 'createdAt']);
      // No update/delete: a code stays with its owner forever
    }
  }
}
